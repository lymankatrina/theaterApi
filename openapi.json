{
  "openapi": "3.1.0",
  "info": {
    "title": "San Juan Theater API",
    "description": "API for the San Juan Theater",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/users/all": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get all users",
        "description": "Returns all users. Administrative access is required.",
        "responses": {
          "200": {
            "description": "Users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "500": {
            "description": "Error getting users"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get current user",
        "description": "Returns the currently authenticated user.",
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "Object",
                  "required": [
                    "userName",
                    "role"
                  ],
                  "properties": {
                    "userName": {
                      "type": "string",
                      "example": "John Smith"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "customer",
                        "employee",
                        "admin"
                      ],
                      "example": "customer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "500": {
            "description": "Error getting user"
          }
        }
      }
    },
    "/users/email/{email}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user by email",
        "description": "Returns a user by email. Administrative access is required.",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "description": "Email address of the user",
            "schema": {
              "type": "string",
              "format": "email",
              "example": "john.smith@example.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "User Email parameter not valid"
          },
          "500": {
            "description": "Error getting user by email"
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user by ID",
        "description": "Returns a user by ID. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "User ID parameter not valid"
          },
          "500": {
            "description": "Error getting user by ID"
          }
        }
      }
    },
    "/users/update/{userId}": {
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update a user",
        "description": "Updates the profile information for a user. A user may update their own profile, or an administrator may update a user's profile.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "userName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "userName": "Test User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully or user is already up to date"
          },
          "400": {
            "description": "Invalid request or no user fields provided"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "User does not have permission to update this user"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Email already in use"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Failed to update user"
          }
        }
      }
    },
    "/users/role/{userId}": {
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update a user's role",
        "description": "Updates a user's role. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "employee",
                      "admin"
                    ]
                  }
                }
              },
              "example": {
                "role": "employee"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User role updated successfully or role is already up to date"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Failed to update user role"
          }
        }
      }
    },
    "/users/delete/{userId}": {
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete a user",
        "description": "Deletes a user. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Failed to delete user"
          }
        }
      }
    },
    "/movies/all": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get all movies",
        "description": "Returns all movies sorted alphabetically by title.",
        "responses": {
          "200": {
            "description": "Movies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error getting movies"
          }
        }
      }
    },
    "/movies/search/{title}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Search movies by title",
        "description": "Returns movies with titles that contain the provided search text. The search is case-insensitive.",
        "parameters": [
          {
            "name": "title",
            "in": "path",
            "required": true,
            "description": "Movie title or partial title to search for",
            "schema": {
              "type": "string",
              "maxLength": 85,
              "example": "spider"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie search completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error searching by movie title"
          }
        }
      }
    },
    "/movies/{movieId}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get movie by ID",
        "description": "Returns one movie by movie ID.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error getting movie by ID"
          }
        }
      }
    },
    "/movies/new": {
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Create a new movie",
        "description": "Creates a new movie. Administrative access is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "tagLine",
                  "overview",
                  "year",
                  "certification",
                  "releaseDate",
                  "genres",
                  "runtime",
                  "poster",
                  "trailer"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "The Shawshank Redemption"
                  },
                  "tagLine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "Fear can hold you prisoner. Hope can set you free."
                  },
                  "overview": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 850,
                    "example": "Two imprisoned men bond over a number of years."
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1888,
                    "maximum": 3000,
                    "example": 1994
                  },
                  "certification": {
                    "type": "string",
                    "enum": [
                      "G",
                      "PG",
                      "PG-13",
                      "R",
                      "NC-17"
                    ],
                    "example": "R"
                  },
                  "releaseDate": {
                    "type": "string",
                    "format": "date",
                    "example": "1994-09-23"
                  },
                  "genres": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Drama"
                  },
                  "runtime": {
                    "type": "string",
                    "example": "2h 22m"
                  },
                  "imdbScore": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0,
                    "maximum": 10,
                    "example": 9.3
                  },
                  "rottenTomatoes": {
                    "type": "string",
                    "example": "89%"
                  },
                  "fandangoAudienceScore": {
                    "type": "string",
                    "example": "98%"
                  },
                  "poster": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/poster.jpg"
                  },
                  "trailer": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/trailer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Movie created successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "422": {
            "description": "Invalid movie data"
          },
          "500": {
            "description": "Unable to create movie"
          }
        }
      }
    },
    "/movies/update/{movieId}": {
      "put": {
        "tags": [
          "Movies"
        ],
        "summary": "Update a movie",
        "description": "Updates an existing movie . Administrative access is required.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the movie to update",
            "schema": {
              "type": "string",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "The Shawshank Redemption"
                  },
                  "tagLine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "Fear can hold you prisoner. Hope can set you free."
                  },
                  "overview": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 850,
                    "example": "Two imprisoned men bond over a number of years."
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1888,
                    "maximum": 3000,
                    "example": 1994
                  },
                  "certification": {
                    "type": "string",
                    "enum": [
                      "G",
                      "PG",
                      "PG-13",
                      "R",
                      "NC-17"
                    ],
                    "example": "R"
                  },
                  "releaseDate": {
                    "type": "string",
                    "format": "date",
                    "example": "1994-09-23"
                  },
                  "genres": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Drama"
                  },
                  "runtime": {
                    "type": "string",
                    "example": "2h 22m"
                  },
                  "imdbScore": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0,
                    "maximum": 10,
                    "example": 9.3
                  },
                  "rottenTomatoes": {
                    "type": "string",
                    "example": "89%"
                  },
                  "fandangoAudienceScore": {
                    "type": "string",
                    "example": "98%"
                  },
                  "poster": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/poster.jpg"
                  },
                  "trailer": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/trailer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Movie updated successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "422": {
            "description": "Invalid movie Id or movie data"
          },
          "500": {
            "description": "Unable to update movie"
          }
        }
      }
    },
    "/movies/delete/{movieId}": {
      "delete": {
        "tags": [
          "Movies"
        ],
        "summary": "Delete a movie",
        "description": "Deletes an existing movie. Administrative access is required.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie deleted successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Failed to delete movie"
          }
        }
      }
    },
    "/seats/all": {
      "get": {
        "tags": [
          "Seats"
        ],
        "summary": "Get all seats",
        "description": "Returns all seats in theater layout order.",
        "responses": {
          "200": {
            "description": "Seats retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Seat"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error retrieving seats"
          }
        }
      }
    },
    "/showtimes/all": {
      "get": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Get all showtimes",
        "description": "Returns all showtimes.",
        "responses": {
          "200": {
            "description": "Showtimes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Showtime"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error getting showtimes"
          }
        }
      }
    },
    "/showtimes/showtime/{showtimeId}": {
      "get": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Get showtime by ID",
        "description": "Returns one showtime by showtime ID.",
        "parameters": [
          {
            "name": "showtimeId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the showtime",
            "schema": {
              "type": "string",
              "example": "6ab43f8cc9819c4743d6203c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Showtime retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Showtime"
                }
              }
            }
          },
          "404": {
            "description": "Showtime not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error retrieving showtime by ID"
          }
        }
      }
    },
    "/showtimes/search/{movieId}": {
      "get": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Get showtimes by Movie ID",
        "description": "Returns all showtimes for the provided movie ID.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "description": "MongoDB ObjectId of the movie",
            "example": "6ab1ce9c052d507320602a7d",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Showtimes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Showtime"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error getting showtimes by ID"
          }
        }
      }
    },
    "/showtimes/new": {
      "post": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Create new showtimes",
        "description": "Creates new showtimes for each date between the provided start date and end date. Administrative access is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShowtimeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Showtimes created successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "409": {
            "description": "One or more showtimes conflict with existing showtimes"
          },
          "422": {
            "description": "Invalid showtime data"
          },
          "500": {
            "description": "Error creating showtimes"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "_id",
          "firstName",
          "lastName",
          "userName",
          "email",
          "role"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "68d07c4a1234567890abcdef"
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          },
          "userName": {
            "type": "string",
            "example": "John Smith"
          },
          "phone": {
            "type": "string",
            "example": "435-555-1234"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.smith@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "employee",
              "admin"
            ],
            "example": "customer"
          }
        }
      },
      "Movie": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "tagLine",
          "overview",
          "year",
          "certification",
          "releaseDate",
          "genres",
          "runtime",
          "poster",
          "trailer"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "68d07c4a1234567890abcdef"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 85,
            "example": "Coyote vs. Acme"
          },
          "tagLine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 85,
            "example": "The movie Acme doesn't want you to see."
          },
          "overview": {
            "type": "string",
            "minLength": 1,
            "maxLength": 850,
            "example": "A tenacious coyote takes on the ACME Corporation."
          },
          "year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 3000,
            "example": 2026
          },
          "certification": {
            "type": "string",
            "enum": [
              "G",
              "PG",
              "PG-13",
              "R",
              "NC-17"
            ],
            "example": "PG"
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-28"
          },
          "genres": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
