{
  "openapi": "3.1.0",
  "info": {
    "title": "San Juan Theater API",
    "description": "API for the San Juan Theater",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get all users",
        "description": "Returns all users or filters users by email address whtn the optional email query parameter is provided. Administrative access is required.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Filter users by email address",
            "schema": {
              "type": "string",
              "format": "email",
              "example": "john.smith@example.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "422": {
            "description": "Email query parameter not valid"
          },
          "500": {
            "description": "Error getting users"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get current user",
        "description": "Returns the currently authenticated user.",
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userName",
                    "role"
                  ],
                  "properties": {
                    "userName": {
                      "type": "string",
                      "example": "John Smith"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "customer",
                        "employee",
                        "admin"
                      ],
                      "example": "customer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "500": {
            "description": "Error getting user"
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user by ID",
        "description": "Returns a user by ID. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "User ID parameter not valid"
          },
          "500": {
            "description": "Error getting user by ID"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update a user",
        "description": "Updates the profile information for a user. A user may update their own profile, or an administrator may update a user's profile.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "userName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "userName": "Test User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully or user is already up to date"
          },
          "400": {
            "description": "Invalid request or no user fields provided"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "User does not have permission to update this user"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Email already in use"
          },
          "422": {
            "description": "User ID parameter not valid"
          },
          "500": {
            "description": "Failed to update user"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete a user",
        "description": "Deletes a user. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "User ID parameter not valid"
          },
          "500": {
            "description": "Failed to delete user"
          }
        }
      }
    },
    "/users/{userId}/role": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Update a user's role",
        "description": "Updates a user's role. Administrative access is required.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "employee",
                      "admin"
                    ]
                  }
                }
              },
              "example": {
                "role": "employee"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User role updated successfully or role is already up to date"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "User ID parameter not valid"
          },
          "500": {
            "description": "Failed to update user role"
          }
        }
      }
    },
    "/movies": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get all movies",
        "description": "Returns all movies sorted alphabetically by title. Optionally filters movies by title using the title query parameter.",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "Filters movies by title. The search is case-insensitive and may match part of a movie title.",
            "schema": {
              "type": "string",
              "maxLength": 85
            },
            "example": "spider"
          }
        ],
        "responses": {
          "200": {
            "description": "Movies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter"
          },
          "500": {
            "description": "Error getting movies"
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Create a new movie",
        "description": "Creates a new movie. Administrative access is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMovieInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Movie created successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "422": {
            "description": "Invalid movie data"
          },
          "500": {
            "description": "Unable to create movie"
          }
        }
      }
    },
    "/movies/{movieId}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get movie by ID",
        "description": "Returns one movie by movie ID.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error getting movie by ID"
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "summary": "Update a movie",
        "description": "Updates an existing movie . Administrative access is required.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the movie to update",
            "schema": {
              "type": "string",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "The Shawshank Redemption"
                  },
                  "tagLine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 85,
                    "example": "Fear can hold you prisoner. Hope can set you free."
                  },
                  "overview": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 850,
                    "example": "Two imprisoned men bond over a number of years."
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1888,
                    "maximum": 3000,
                    "example": 1994
                  },
                  "certification": {
                    "type": "string",
                    "enum": [
                      "G",
                      "PG",
                      "PG-13",
                      "R",
                      "NC-17"
                    ],
                    "example": "R"
                  },
                  "releaseDate": {
                    "type": "string",
                    "format": "date",
                    "example": "1994-09-23"
                  },
                  "genres": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Drama"
                  },
                  "runtime": {
                    "type": "string",
                    "example": "2h 22m"
                  },
                  "imdbScore": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0,
                    "maximum": 10,
                    "example": 9.3
                  },
                  "rottenTomatoes": {
                    "type": "string",
                    "example": "89%"
                  },
                  "fandangoAudienceScore": {
                    "type": "string",
                    "example": "98%"
                  },
                  "poster": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/poster.jpg"
                  },
                  "trailer": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.com/trailer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Movie updated successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "422": {
            "description": "Invalid movie Id or movie data"
          },
          "500": {
            "description": "Unable to update movie"
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "summary": "Delete a movie",
        "description": "Deletes an existing movie and its associated showtimes and tickets. A movie cannot be deleted if any associated tickets are reserved or sold. Administrative access is required.",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66c8e0d1f0a123456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie and associated showtimes and tickets deleted successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "409": {
            "description": "Movie cannot be deleted because it has reserved or sold tickets"
          },
          "422": {
            "description": "Movie ID parameter not valid"
          },
          "500": {
            "description": "Failed to delete movie"
          }
        }
      }
    },
    "/seats": {
      "get": {
        "tags": [
          "Seats"
        ],
        "summary": "Get all seats",
        "description": "Returns all seats in theater layout order.",
        "responses": {
          "200": {
            "description": "Seats retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Seat"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error retrieving seats"
          }
        }
      }
    },
    "/showtimes": {
      "get": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Get all showtimes",
        "description": "Returns all showtimes. Optionally filters showtimes by movie using the movieId query parameter.",
        "parameters": [
          {
            "name": "movieId",
            "in": "query",
            "required": false,
            "description": "Filters showtimes by movieId. If provided, the value must be a valid MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "68d07c4a1234567890abcdef"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Showtimes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Showtime"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter"
          },
          "500": {
            "description": "Error getting showtimes"
          }
        }
      },
      "post": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Create new showtimes",
        "description": "Creates new showtimes for each date between the provided start date and end date and automatically generates tickets for each created showtime. Administrative access is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShowtimeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Showtimes and tickets created successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Movie not found"
          },
          "409": {
            "description": "One or more showtimes conflict with existing showtimes"
          },
          "422": {
            "description": "Invalid showtime data"
          },
          "500": {
            "description": "Error creating showtimes"
          }
        }
      }
    },
    "/showtimes/{showtimeId}": {
      "get": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Get showtime by ID",
        "description": "Returns one showtime by showtime ID.",
        "parameters": [
          {
            "name": "showtimeId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the showtime",
            "schema": {
              "type": "string",
              "example": "6ab43f8cc9819c4743d6203c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Showtime retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Showtime"
                }
              }
            }
          },
          "404": {
            "description": "Showtime not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error retrieving showtime by ID"
          }
        }
      },
      "delete": {
        "tags": [
          "Showtimes"
        ],
        "summary": "Delete a showtime",
        "description": "Deletes a showtime and its associated tickets. A showtime cannot be deleted if any associated tickets are reserved or sold. Administrative access is required.",
        "parameters": [
          {
            "name": "showtimeId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the showtime",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "66c8e0d1f0a000456789abcd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Showtime and associated tickets deleted successfully"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "Showtime not found"
          },
          "409": {
            "description": "Showtime cannot be deleted because it has reserved or sold tickets"
          },
          "422": {
            "description": "Showtime ID parameter not valid"
          },
          "500": {
            "description": "Error deleting showtime"
          }
        }
      }
    },
    "/tickets/{showtimeId}": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Generate tickets for a showtime",
        "description": "Generates one ticket for each configured theater seat for the provided showtime. Administrative access is required.",
        "parameters": [
          {
            "name": "showtimeId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the showtime",
            "schema": {
              "type": "string",
              "example": "6ab43f8cc9819c4743d6203d"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tickets created successfully"
          },
          "200": {
            "description": "All tickets already exist for the showtime"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "404": {
            "description": "One or more tickets already exist for the showtime and seat"
          },
          "422": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Error generating tickets"
          }
        }
      }
    },
    "/concessions": {
      "get": {
        "tags": [
          "Concessions"
        ],
        "summary": "Get active concessions",
        "description": "Returns all active concessions. An optional search query can be used to search by name or description.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search active concessions by name or description",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "example": "popcorn"
          }
        ],
        "responses": {
          "200": {
            "description": "Active concessions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Concession"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid search query"
          },
          "500": {
            "description": "Error getting concessions"
          }
        }
      },
      "post": {
        "tags": [
          "Concessions"
        ],
        "summary": "Create a concession",
        "description": "Creates a new concession. Administrative access is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConcessionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Concession created successfully"
          },
          "400": {
            "description": "Invalid concession data"
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "409": {
            "description": "A concession with this name already exists"
          },
          "422": {
            "description": "Validation error"
          },
          "500": {
            "description": "Unable to create concession"
          }
        }
      }
    },
    "/concessions/admin": {
      "get": {
        "tags": [
          "Concessions"
        ],
        "summary": "Get all concessions",
        "description": "Returns all active and inactive concessions. Administrative access is required. An optional search query can be used to search by name, description, or exact concession ID",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search concessions by name, description, or exact concession ID",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "example": "popcorn"
          }
        ],
        "responses": {
          "200": {
            "description": "Concessions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Concession"
                  }
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated"
          },
          "403": {
            "description": "Administrative access required"
          },
          "422": {
            "description": "Invalid search query"
          },
          "500": {
            "description": "Error getting all concessions"
          }
        }
      }
    },
    "/concessions/{concessionId}": {
      "get": {
        "tags": [
          "Concessions"
        ],
        "summary": "Get active concession by its ID.",
        "description": "Returns an active concession by its ID.",
        "parameters": [
          {
            "name": "concessionId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the concession",
            "schema": {
              "type": "string",
              "format": "objectId",
              "example": "68d5f28a2d9c123456789abc"
            }
          }
        ],
        "responses": {
          "200": {
